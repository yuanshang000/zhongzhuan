# ===== CloudRive 配置示例 =====
# 复制为 .env 后按需修改：cp .env.example .env
# 注意：存储路径也可在网页「存储设置」中直接修改，此处仅为初始默认值

# ---- 基础 ----
# 对外访问地址，用于拼接分享链接。部署到公网时必填，例如 https://pan.example.com
PUBLIC_BASE_URL=

# 存储后端: local | s3
STORAGE_BACKEND=local

# 本地存储目录。默认存到项目下的 document 文件夹，不存在会自动创建
LOCAL_STORAGE_DIR=./document

# 数据库连接串。默认 SQLite，无需额外安装
DATABASE_URL=sqlite:///./data/cloudrive.db

# 跨域。前后端同域时保持 * 即可
CORS_ORIGINS=*

# ---- 分片上传 ----
# 分片大小（字节），必须 >= 5 MiB（S3 协议硬性要求）。
# 32 MiB 是速度与稳定性的平衡点；调大减少请求数，但单片失败要重传更多
MULTIPART_CHUNK_SIZE=33554432

# 小于此阈值的文件走单请求直传（字节），更大的走分片并发
DIRECT_UPLOAD_THRESHOLD=8388608

# ---- 访问控制 ----
# 面板访问密码。留空 = 不需要密码（任何人可打开面板）
# 设置后：打开面板需输入密码；分享链接仍然免登录直接访问
PANEL_PASSWORD=

# 登录令牌签名密钥（重要！）
# 留空则运行时随机生成，服务重启后需要重新登录。
# 生产环境务必填写固定值，生成方法：openssl rand -base64 48
AUTH_SECRET=

# 登录会话有效期（秒）。604800 = 7 天
# 到期后必须重新输入密码才能进入系统。
# 想改时长直接改这个数字：3天=259200，30天=2592000
SESSION_MAX_AGE=604800

# 连续输错几次后临时锁定
MAX_LOGIN_ATTEMPTS=5

# 锁定时长（秒）
LOCKOUT_SECONDS=300

# ---- 存储配额（可选）----
# 云盘可用容量上限。留空 = 用磁盘真实剩余空间。
# 写法：10GB / 500MB / 2TB / 1.5GB，也可直接写字节数 10737418240
# 设置后，面板显示"已用 / 配额上限"，而不是磁盘真实容量
STORAGE_QUOTA=

# ---- S3 / MinIO 后端时才需要 ----
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=cloudrive
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
