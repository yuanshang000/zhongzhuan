# ===== 存储数据（用户文件与运行时状态，绝不入库）=====
document/
/data/
*.db
*.db-journal
*.sqlite
*.sqlite3
runtime_settings.json
upload_sessions.json
.parts/

# ===== 环境与密钥 =====
# .env 含真实密码与 AUTH_SECRET，绝不能提交。
# 需要分享配置模板时提交 .env.example（已放占位符，无敏感值）。
.env
.env.local
.env.*.local

# ===== 证书与私钥 =====
# 私钥进 git 等于公开泄露：即使后续删除，历史提交里仍能翻出来。
# 仓库只保留 deploy/certs/generate-cert.* 脚本，证书本地生成。
*.key
*.pem
*.pfx
*.p12
*.crt
*.cer
deploy/certs/server.*

# ===== Python =====
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 前端 =====
node_modules/
npm-debug.log*

# ===== 编辑器与系统 =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ===== 日志与临时文件 =====
*.log
logs/
tmp/
temp/
*.bak
*.tmp

# ===== 截图临时产物 =====
# docs/images/ 是README 要用的，需要入库，故不忽略
